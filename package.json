{
  "name": "vanderhall-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "node scripts/process-images.mjs",
    "build": "node src/build.mjs && node scripts/prepare-vercel.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:video": "node scripts/check-video.mjs",
    "check": "npm run check:links && npm run check:content && npm run check:video",
    "verify:browser": "node scripts/verify-browser.mjs",
    "build:production": "VHW_MODE=production node src/build.mjs && node scripts/prepare-vercel.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}

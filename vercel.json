{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/about/", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/dealers/", "permanent": true },
    { "source": "/contact/", "destination": "/dealers/", "permanent": true }
  ]
}
